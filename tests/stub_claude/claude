#!/usr/bin/env bash
# Stub claude binary for maintenance_run.sh tests.
#
# Accepts the real headless flag surface, extracts the repo path from the
# prompt's "{{REPO}}"-rendered text, and mutates the repo according to
# STUB_CLAUDE_MODE:
#   good       add a valid fleeting note + log lines, commit, exit 0
#   violate    add an UNVERIFIED reference note, commit, exit 0
#   overbudget partial commit then exit 7 (simulated --max-turns cutoff)
#   push       like good, but also tries to git push (must be a no-op rail test)
#   slow       like good, but sleeps 3s first (lock-contention tests)
#   smith        like good, plus a wellformed child-skill proposal recorded via
#                skill_review.py propose (the FR-35 happy path)
#   smith-escape like smith, but also plants a file in the PLUGIN repo — the
#                AC-37 write the wrapper must block and log

set -euo pipefail

PROMPT=""
ALLOWED=""
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  if [[ "${args[$i]}" == "-p" ]]; then PROMPT="${args[$((i+1))]}"; fi
  if [[ "${args[$i]}" == "--allowedTools" ]]; then ALLOWED="${args[$((i+1))]}"; fi
done

# Regression check for the word-splitting bug that shattered the allowlist:
# the whole list must arrive as ONE argument still containing the space-y
# git patterns, or a real run gets its commits denied.
if [[ "$ALLOWED" != *"Bash(git commit:*)"* || "$ALLOWED" != *"Bash(git add:*)"* ]]; then
  echo "stub: --allowedTools arrived mangled: '$ALLOWED'" >&2
  exit 8
fi

# The prompt invokes scripts by absolute interpreter path, so that exact path
# must be allowlisted or every script call is silently denied (found live).
PYBIN_SEEN="${PYTHON:-python3}"
PYBIN_ABS="$(command -v "$PYBIN_SEEN" 2>/dev/null || echo "$PYBIN_SEEN")"
if [[ "$ALLOWED" != *"Bash(${PYBIN_ABS}:*)"* ]]; then
  echo "stub: run interpreter '$PYBIN_ABS' is not allowlisted: '$ALLOWED'" >&2
  exit 8
fi

REPO="$(printf '%s\n' "$PROMPT" | grep -oE 'repository at [^ ]+' | head -1 | awk '{print $3}' | sed 's/[.,]$//')"
[[ -d "$REPO" ]] || { echo "stub: could not find repo in prompt" >&2; exit 9; }

MODE="${STUB_CLAUDE_MODE:-good}"
STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

[[ "$MODE" == "slow" ]] && sleep 3

for n in 2 3 4 5 6 7 8 9 10; do
  echo "- \`$STAMP\` step $n: stub ($MODE)" >> "$REPO/log.md"
done

if [[ "$MODE" == "violate" ]]; then
  KEY="planted-unverified-claim--209901010000"
  mkdir -p "$REPO/reference"
  cat > "$REPO/reference/$KEY.md" <<NOTE
---
id: "209901010000"
key: "$KEY"
slug: "planted-unverified-claim"
aliases: ["209901010000"]
type: reference
title: "A source nobody verified"
tags: []
source_tier: general-web
scripture: false
csl_json:
  id: "209901010000"
  type: webpage
  title: "A source nobody verified"
chicago_note: "made up by hand"
chicago_bib: "made up by hand"
verification: {method: "", source: "", verified: false, date: ""}
raw_capture: ""
links: []
---
Planted violation.
NOTE
else
  KEY="stub-run-observation--209901010001"
  mkdir -p "$REPO/fleeting"
  cat > "$REPO/fleeting/$KEY.md" <<NOTE
---
id: "209901010001"
key: "$KEY"
slug: "stub-run-observation"
aliases: ["209901010001"]
type: fleeting
title: "Stub run observation"
tags: []
links: []
---
Written by the stub claude ($MODE).
NOTE
fi

# keep the manifest coherent with whatever we just added
PYBIN="${PYTHON:-python3}"
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../scripts" && pwd)"
PYTHONPATH="$SCRIPTS_DIR" "$PYBIN" "$SCRIPTS_DIR/build_manifest.py" --repo "$REPO" >/dev/null

if [[ "$MODE" == smith* ]]; then
  # A wellformed proposal citing the fleeting note this run just added (its
  # key resolves once the manifest above is rebuilt), recorded the way the
  # smith is instructed to: skill_review.py propose, as its final act.
  mkdir -p "$REPO/skills/demo-skill"
  cat > "$REPO/skills/demo-skill/SKILL.md" <<'SKILLMD'
---
name: demo-skill
description: A stub-proposed child skill for sandbox testing.
---
# demo-skill

## When to use
In stub maintenance runs.

## Procedure
1. Exist.
SKILLMD
  cat > "$REPO/skills/demo-skill/PURPOSE.md" <<'PURPOSEMD'
---
skill: "demo-skill"
status: proposed
proposal_id: ""
kind: create
proposed: "2099-01-01"
decided: ""
---
# Purpose — demo-skill

## Origin
Proposed by the stub retrospective.

## Patterns-Addressed
Motivated by [[stub-run-observation--209901010001]].

## Evolution-History
| date | change | outcome |
|------|--------|---------|
PURPOSEMD
  PYTHONPATH="$SCRIPTS_DIR" "$PYBIN" "$SCRIPTS_DIR/skill_review.py" --repo "$REPO" \
    propose --skill demo-skill --kind create \
    --motivation "stub agents keep reinventing this" >/dev/null
fi

if [[ "$MODE" == "smith-escape" ]]; then
  STUB_PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
  echo "escaped" > "$STUB_PLUGIN_ROOT/.stub-escape"
fi

git -C "$REPO" add -A
git -C "$REPO" -c user.name=stub -c user.email=stub@localhost \
  commit -q -m "stub maintenance run ($MODE)"

if [[ "$MODE" == "push" ]]; then
  git -C "$REPO" push origin "$(git -C "$REPO" branch --show-current)" || true
fi

if [[ "$MODE" == "overbudget" ]]; then
  echo '{"result":"cut off at max turns"}';
  exit 7
fi

echo '{"result":"stub maintenance run complete"}'
